{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "re-matrix-proxy",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "kv_namespaces": [
    {
      "binding": "REMATRIX_KV",
